# Скопируйте в .env.local для локального запуска: cp .env.example .env.local
# На Vercel те же переменные задаются в Settings → Environment Variables.
# Файлы .env* (кроме этого примера) в git не попадают.

# Пароль владельца атласа. Без него вход отключён, сайт только для просмотра.
# Обязательно на проде. Лучше длинный: 12+ символов.
ADMIN_PASSWORD=

# Секрет для подписи входа (куки). Обязательно на проде, 32+ случайных символа:
#   openssl rand -base64 32
# Локально можно не задавать — тогда он выводится из ADMIN_PASSWORD.
SESSION_SECRET=

# Строка подключения к Postgres. Локально оставьте пустой — данные будут во
# встроенной базе в папке .data. На Vercel обязательна (Neon: строка «Pooled
# connection», вида postgresql://user:pass@ep-...-pooler.region.aws.neon.tech/neondb?sslmode=require).
DATABASE_URL=

# Необязательно. Демо-поездки при первом запуске пустой базы:
# по умолчанию локально — да, с DATABASE_URL — нет. 1 — включить, 0 — выключить.
SEED_DEMO=

# Необязательно. Свой домен для превью ссылок в Telegram, например https://atlas.example.com
# На Vercel без него берётся основной адрес проекта.
SITE_URL=
